# Copy this file to .env.local and fill in your values. .env.local is git-ignored.

# Neon → your project → Connect → copy the connection string (pooled is fine).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Optional: port for the API server (Vite proxies /api to it in development).
# API_PORT=8787
