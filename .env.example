# Copy this file to .env.local and fill in your values. .env.local is git-ignored.

# Neon → your project → Connect → copy the connection string (pooled is fine).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Optional: turns on Practice → Conversation (AI partner). Server-side only.
# Get a key at console.anthropic.com → API keys.
# ANTHROPIC_API_KEY=sk-ant-...
# While it's in testing, only admin accounts (users.is_admin, the same as Wordle Unlimited) can use it.
# Optional: a different Claude model for conversations (default claude-opus-5-5).
# LINGORA_CHAT_MODEL=claude-opus-5-5

# Optional: GIF search in friend and group chats (the same key as Wordle Unlimited).
# GIPHY_API_KEY=

# Optional: port for the API server (Vite proxies /api to it in development).
# API_PORT=8787
